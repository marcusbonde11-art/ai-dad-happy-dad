{
  "name": "AI Dad Clips 1/2 – Drive watch → Descript import",
  "flow": [
    {
      "id": 1,
      "module": "google-drive:watchFilesInAFolder",
      "version": 4,
      "parameters": {
        "__IMTCONN__": 11845960,
        "select": "create",
        "destination": "drive",
        "folderId": "1fAVvXFnkZPAaHAP0gFWCHTyyFSLMM_Fa",
        "mimeType": "all",
        "limit": 20
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0,
          "name": "Watch 'AI Dad Happy Dad - Raw Recordings' (every 15 min)"
        }
      }
    },
    {
      "id": 2,
      "module": "util:SetVariables",
      "version": 1,
      "parameters": {},
      "filter": {
        "name": "Only video or audio files",
        "conditions": [
          [
            {
              "a": "{{1.mimeType}}",
              "o": "text:startwith",
              "b": "video/"
            }
          ],
          [
            {
              "a": "{{1.mimeType}}",
              "o": "text:startwith",
              "b": "audio/"
            }
          ]
        ]
      },
      "mapper": {
        "variables": [
          {
            "name": "DESCRIPT_API_TOKEN",
            "value": "PASTE_DESCRIPT_API_TOKEN_HERE"
          },
          {
            "name": "DESCRIPT_CALLBACK_URL",
            "value": "PASTE_WEBHOOK_URL_FROM_SCENARIO_2_HERE"
          },
          {
            "name": "DESCRIPT_FOLDER",
            "value": "AI Dad Healthy Dad/Auto clips"
          },
          {
            "name": "MAX_UPLOAD_BYTES",
            "value": 100000000
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0,
          "name": "CONFIG – paste Descript token + webhook URL"
        }
      }
    },
    {
      "id": 3,
      "module": "google-drive:getAFileFolderMetadata",
      "version": 4,
      "parameters": {
        "__IMTCONN__": 11845960
      },
      "mapper": {
        "select": "map",
        "select1": "file",
        "file": "{{1.id}}"
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0,
          "name": "Read file size (metadata only, no download)"
        }
      }
    },
    {
      "id": 4,
      "module": "builtin:BasicRouter",
      "version": 1,
      "mapper": null,
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0
        }
      },
      "routes": [
        {
          "flow": [
            {
              "id": 10,
              "module": "google-drive:getAFile",
              "version": 4,
              "parameters": {
                "__IMTCONN__": 11845960
              },
              "filter": {
                "name": "Fits Make file-size limit",
                "conditions": [
                  [
                    {
                      "a": "{{3.size}}",
                      "o": "number:lessorequal",
                      "b": "{{2.MAX_UPLOAD_BYTES}}"
                    }
                  ]
                ]
              },
              "mapper": {
                "select": "map",
                "file": "{{1.id}}"
              },
              "metadata": {
                "designer": {
                  "x": 1200,
                  "y": -150,
                  "name": "Download recording privately (Drive connection, no sharing)"
                }
              }
            },
            {
              "id": 11,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": {
                "handleErrors": true,
                "useNewZLibDeCompress": true
              },
              "mapper": {
                "url": "https://descriptapi.com/v1/jobs/import/project_media",
                "method": "post",
                "headers": [
                  {
                    "name": "Authorization",
                    "value": "Bearer {{2.DESCRIPT_API_TOKEN}}"
                  }
                ],
                "qs": [],
                "bodyType": "raw",
                "contentType": "application/json",
                "data": "{\"project_name\": \"AI Dad – {{1.name}}\", \"folder_name\": \"{{2.DESCRIPT_FOLDER}}\", \"add_media\": {\"recording\": {\"content_type\": \"{{1.mimeType}}\", \"file_size\": {{3.size}}, \"language\": \"en\"}}, \"add_compositions\": [{\"name\": \"Full – {{1.name}}\", \"width\": 1080, \"height\": 1920, \"clips\": [{\"media\": \"recording\"}]}], \"callback_url\": \"{{2.DESCRIPT_CALLBACK_URL}}\"}",
                "parseResponse": true,
                "serializeUrl": false,
                "shareCookies": false,
                "rejectUnauthorized": true,
                "followRedirect": true,
                "followAllRedirects": false,
                "useQuerystring": false,
                "gzip": true,
                "useMtls": false
              },
              "metadata": {
                "designer": {
                  "x": 1500,
                  "y": -150,
                  "name": "Descript: create project + get signed upload URL (direct upload)"
                }
              }
            },
            {
              "id": 12,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": {
                "handleErrors": true,
                "useNewZLibDeCompress": true
              },
              "mapper": {
                "url": "{{11.data.upload_urls.recording.upload_url}}",
                "method": "put",
                "headers": [],
                "qs": [],
                "bodyType": "raw",
                "contentType": "custom",
                "customContentType": "application/octet-stream",
                "data": "{{10.data}}",
                "parseResponse": false,
                "timeout": 300,
                "serializeUrl": false,
                "shareCookies": false,
                "rejectUnauthorized": true,
                "followRedirect": true,
                "followAllRedirects": false,
                "useQuerystring": false,
                "gzip": true,
                "useMtls": false
              },
              "metadata": {
                "designer": {
                  "x": 1800,
                  "y": -150,
                  "name": "PUT the bytes to Descript (import + transcription start on arrival)"
                }
              }
            },
            {
              "id": 13,
              "module": "google-sheets:addRow",
              "version": 2,
              "parameters": {
                "__IMTCONN__": 11391947
              },
              "mapper": {
                "mode": "map",
                "insertUnformatted": false,
                "valueInputOption": "USER_ENTERED",
                "spreadsheetId": "18oYWSHC-30GD_oGVgJIMp3iKMnys5_y1qGuCHNrl4Yg",
                "sheetId": "Sheet1",
                "tableFirstRow": "A1:Z1",
                "values": {
                  "0": "{{formatDate(now; \"YYYY-MM-DD HH:mm\"; \"America/New_York\")}}",
                  "1": "1. Uploaded to Descript · transcribing",
                  "2": "ok",
                  "3": "{{1.name}}",
                  "4": "{{1.id}}",
                  "5": "{{11.data.project_id}}",
                  "6": "{{11.data.project_url}}",
                  "7": "{{11.data.job_id}}",
                  "15": "Recording ({{round(3.size / 1048576)}} MB) was downloaded through your private Drive connection and uploaded straight to Descript. Nothing was link-shared. The clip step starts when Descript calls back into scenario 2."
                }
              },
              "metadata": {
                "designer": {
                  "x": 2100,
                  "y": -150,
                  "name": "Log → Review Log sheet"
                }
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 20,
              "module": "google-sheets:addRow",
              "version": 2,
              "parameters": {
                "__IMTCONN__": 11391947
              },
              "mapper": {
                "mode": "map",
                "insertUnformatted": false,
                "valueInputOption": "USER_ENTERED",
                "spreadsheetId": "18oYWSHC-30GD_oGVgJIMp3iKMnys5_y1qGuCHNrl4Yg",
                "sheetId": "Sheet1",
                "tableFirstRow": "A1:Z1",
                "values": {
                  "0": "{{formatDate(now; \"YYYY-MM-DD HH:mm\"; \"America/New_York\")}}",
                  "1": "1. SKIPPED – recording too large for Make",
                  "2": "needs you",
                  "3": "{{1.name}}",
                  "4": "{{1.id}}",
                  "15": "This file is {{round(3.size / 1048576)}} MB. The Make Core plan moves files up to 100 MB only, and this pipeline never link-shares recordings, so it was skipped. Options: trim or re-export it under 100 MB and drop it in again, or import it into Descript by hand (the rest of the pipeline will not run for a manual import). Nothing was changed in Drive."
                }
              },
              "metadata": {
                "designer": {
                  "x": 1200,
                  "y": 150,
                  "name": "Log → needs Marcus (file too large)"
                }
              },
              "filter": {
                "name": "Too large for the Make plan",
                "conditions": [
                  [
                    {
                      "a": "{{3.size}}",
                      "o": "number:greater",
                      "b": "{{2.MAX_UPLOAD_BYTES}}"
                    }
                  ]
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "metadata": {
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    }
  }
}
