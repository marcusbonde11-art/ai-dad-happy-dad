                            "name": "Authorization",
                            "value": "Bearer {{2.DESCRIPT_API_TOKEN}}"
                          }
                        ],
                        "qs": [],
                        "bodyType": "raw",
                        "contentType": "application/json",
                        "data": "{\"project_id\": \"{{1.project_id}}\", \"composition_id\": \"{{21.CLIP_COMP_ID}}\", \"media_type\": \"Video\", \"resolution\": \"1080p\", \"callback_url\": \"{{2.DESCRIPT_CALLBACK_URL}}\"}",
                        "parseResponse": true,
                        "serializeUrl": false,
                        "shareCookies": false,
                        "rejectUnauthorized": true,
                        "followRedirect": true,
                        "followAllRedirects": false,
                        "useQuerystring": false,
                        "gzip": true,
                        "useMtls": false
                      },
                      "metadata": {
                        "designer": {
                          "x": 2100,
                          "y": -200,
                          "name": "Descript: render + publish clip (async, calls back)"
                        }
                      }
                    },
                    {
                      "id": 31,
                      "module": "google-sheets:addRow",
                      "version": 2,
                      "parameters": {
                        "__IMTCONN__": 11391947
                      },
                      "mapper": {
                        "mode": "map",
                        "insertUnformatted": false,
                        "valueInputOption": "USER_ENTERED",
                        "spreadsheetId": "18oYWSHC-30GD_oGVgJIMp3iKMnys5_y1qGuCHNrl4Yg",
                        "sheetId": "Sheet1",
                        "tableFirstRow": "A1:Z1",
                        "values": {
                          "0": "{{formatDate(now; \"YYYY-MM-DD HH:mm\"; \"America/New_York\")}}",
                          "1": "3. Clip chosen · rendering",
                          "2": "ok",
                          "5": "{{1.project_id}}",
                          "6": "{{1.project_url}}",
                          "7": "{{30.data.job_id}}",
                          "15": "Composition '{{21.CLIP_COMP_NAME}}' ({{22.CLIP_DURATION}}s) is being rendered. Underlord said: {{1.result.agent_response}}"
                        }
                      },
                      "metadata": {
                        "designer": {
                          "x": 2400,
                          "y": -200,
                          "name": "Log → Review Log sheet"
                        }
                      }
                    }
                  ]
                },
                {
                  "flow": [
                    {
                      "id": 35,
                      "module": "google-sheets:addRow",
                      "version": 2,
                      "parameters": {
                        "__IMTCONN__": 11391947
                      },
                      "filter": {
                        "name": "Clip too long – stop",
                        "conditions": [
                          [
                            {
                              "a": "{{22.CLIP_DURATION}}",
                              "o": "number:greater",
                              "b": "{{2.MAX_CLIP_SECONDS}}"
                            }
                          ]
                        ]
                      },
                      "mapper": {
                        "mode": "map",
                        "insertUnformatted": false,
                        "valueInputOption": "USER_ENTERED",
                        "spreadsheetId": "18oYWSHC-30GD_oGVgJIMp3iKMnys5_y1qGuCHNrl4Yg",
                        "sheetId": "Sheet1",
                        "tableFirstRow": "A1:Z1",
                        "values": {
                          "0": "{{formatDate(now; \"YYYY-MM-DD HH:mm\"; \"America/New_York\")}}",
                          "1": "3. STOPPED – clip too long",
                          "2": "needs you",
                          "5": "{{1.project_id}}",
                          "6": "{{1.project_url}}",
                          "15": "Composition '{{21.CLIP_COMP_NAME}}' is {{22.CLIP_DURATION}}s, over the {{2.MAX_CLIP_SECONDS}}s limit, so nothing was published or scheduled. Open the project, cut it down and publish from Descript, or raise MAX_CLIP_SECONDS. Underlord said: {{1.result.agent_response}}"
                        }
                      },
                      "metadata": {
                        "designer": {
                          "x": 2100,
                          "y": 0,
                          "name": "Log → needs Marcus"
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "flow": [
            {
              "id": 40,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": {
                "handleErrors": true,
                "useNewZLibDeCompress": true
              },
              "filter": {
                "name": "C · Clip published OK",
                "conditions": [
                  [
                    {
                      "a": "{{1.job_type}}",
                      "o": "text:equal",
                      "b": "publish"
