    {
      "id": 3,
      "module": "builtin:BasicRouter",
      "version": 1,
      "mapper": null,
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        }
      },
      "routes": [
        {
          "flow": [
            {
              "id": 10,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": {
                "handleErrors": true,
                "useNewZLibDeCompress": true
              },
              "filter": {
                "name": "A · Import finished OK",
                "conditions": [
                  [
                    {
                      "a": "{{1.job_type}}",
                      "o": "text:equal",
                      "b": "import/project_media"
                    },
                    {
                      "a": "{{1.result.status}}",
                      "o": "text:equal",
                      "b": "success"
                    }
                  ],
                  [
                    {
                      "a": "{{1.job_type}}",
                      "o": "text:equal",
                      "b": "import"
                    },
                    {
                      "a": "{{1.result.status}}",
                      "o": "text:equal",
                      "b": "success"
                    }
                  ]
                ]
              },
              "mapper": {
                "url": "https://descriptapi.com/v1/jobs/agent",
                "method": "post",
                "headers": [
                  {
                    "name": "Authorization",
                    "value": "Bearer {{2.DESCRIPT_API_TOKEN}}"
                  }
                ],
                "qs": [],
                "bodyType": "raw",
                "contentType": "application/json",
                "data": "{\"project_id\": \"{{1.project_id}}\", \"callback_url\": \"{{2.DESCRIPT_CALLBACK_URL}}\", \"prompt\": \"Edit this raw talking-head recording into one short vertical clip for TikTok and Instagram Reels. 1) Use your clip-finding to pick the single best self-contained moment, 20 to 60 seconds long: a sharp, specific, scroll-stopping first line, one clear idea, and a natural ending. 2) Create a NEW composition named exactly '{{2.CLIP_COMPOSITION_NAME}}' containing only that moment, vertical 9:16 (1080x1920). If you cannot create a new composition, trim the existing composition down to that moment instead. 3) In the clip: remove filler words, apply Studio Sound, and add clean, large captions that are readable on a phone. 4) Do not add music, stock footage, B-roll, AI voices, eye-contact fixes or effects. Keep it raw and real. 5) Do not delete or alter the original media files.\"}",
                "parseResponse": true,
                "serializeUrl": false,
                "shareCookies": false,
                "rejectUnauthorized": true,
                "followRedirect": true,
                "followAllRedirects": false,
                "useQuerystring": false,
                "gzip": true,
                "useMtls": false
              },
              "metadata": {
                "designer": {
                  "x": 900,
                  "y": -300,
                  "name": "Descript Underlord: find best clip (async, calls back)"
                }
              }
            },
            {
              "id": 11,
              "module": "google-sheets:addRow",
              "version": 2,
              "parameters": {
                "__IMTCONN__": 11391947
              },
              "mapper": {
                "mode": "map",
                "insertUnformatted": false,
                "valueInputOption": "USER_ENTERED",
                "spreadsheetId": "18oYWSHC-30GD_oGVgJIMp3iKMnys5_y1qGuCHNrl4Yg",
                "sheetId": "Sheet1",
                "tableFirstRow": "A1:Z1",
                "values": {
                  "0": "{{formatDate(now; \"YYYY-MM-DD HH:mm\"; \"America/New_York\")}}",
                  "1": "2. Transcribed · clip finding started",
                  "2": "ok",
                  "5": "{{1.project_id}}",
                  "6": "{{1.project_url}}",
                  "7": "{{10.data.job_id}}",
                  "15": "Descript transcribed the file ({{1.result.media_seconds_used}}s of media). Underlord is now picking the clip; the next row appears when it calls back."
                }
              },
              "metadata": {
                "designer": {
                  "x": 1200,
                  "y": -300,
                  "name": "Log → Review Log sheet"
                }
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 20,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": {
                "handleErrors": true,
                "useNewZLibDeCompress": true
              },
              "filter": {
                "name": "B · Clip edit finished OK",
                "conditions": [
                  [
                    {
                      "a": "{{1.job_type}}",
                      "o": "text:equal",
                      "b": "agent"
                    },
                    {
                      "a": "{{1.result.status}}",
                      "o": "text:equal",
                      "b": "success"
                    }
                  ]
                ]
              },
              "mapper": {
                "url": "https://descriptapi.com/v1/projects/{{1.project_id}}",
                "method": "get",
                "headers": [
                  {
                    "name": "Authorization",
                    "value": "Bearer {{2.DESCRIPT_API_TOKEN}}"
                  }
                ],
                "qs": [],
                "bodyType": "",
                "parseResponse": true,
                "serializeUrl": false,
                "shareCookies": false,
                "rejectUnauthorized": true,
                "followRedirect": true,
                "followAllRedirects": false,
                "useQuerystring": false,
                "gzip": true,
                "useMtls": false
              },
              "metadata": {
                "designer": {
                  "x": 900,
                  "y": -100,
                  "name": "Descript: list compositions in project"
                }
              }
            },
            {
              "id": 21,
              "module": "util:SetVariables",
              "version": 1,
              "parameters": {},
              "mapper": {
                "variables": [
                  {
                    "name": "CLIP_COMP_ID",
                    "value": "{{ifempty(get(map(20.data.compositions; \"id\"; \"name\"; 2.CLIP_COMPOSITION_NAME); 1); get(map(20.data.compositions; \"id\"); length(20.data.compositions)))}}"
                  },
                  {
                    "name": "CLIP_COMP_NAME",
                    "value": "{{ifempty(get(map(20.data.compositions; \"name\"; \"name\"; 2.CLIP_COMPOSITION_NAME); 1); get(map(20.data.compositions; \"name\"); length(20.data.compositions)))}}"
                  }
                ]
              },
              "metadata": {
                "designer": {
                  "x": 1200,
                  "y": -100,
                  "name": "Pick the clip composition ('AI Dad Clip', else newest)"
                }
              }
            },
            {
              "id": 22,
              "module": "util:SetVariables",
              "version": 1,
              "parameters": {},
              "mapper": {
                "variables": [
                  {
                    "name": "CLIP_DURATION",
                    "value": "{{get(map(20.data.compositions; \"duration\"; \"id\"; 21.CLIP_COMP_ID); 1)}}"
                  }
                ]
              },
              "metadata": {
                "designer": {
                  "x": 1500,
                  "y": -100,
                  "name": "Clip duration (seconds)"
                }
              }
            },
            {
              "id": 23,
              "module": "builtin:BasicRouter",
              "version": 1,
              "mapper": null,
              "metadata": {
                "designer": {
                  "x": 1800,
                  "y": -100
                }
              },
              "routes": [
                {
                  "flow": [
                    {
                      "id": 30,
                      "module": "http:ActionSendData",
                      "version": 3,
                      "parameters": {
                        "handleErrors": true,
                        "useNewZLibDeCompress": true
                      },
                      "filter": {
                        "name": "Clip is short enough (or duration unknown)",
                        "conditions": [
                          [
                            {
                              "a": "{{22.CLIP_DURATION}}",
                              "o": "number:lessorequal",
                              "b": "{{2.MAX_CLIP_SECONDS}}"
                            }
                          ],
                          [
                            {
                              "a": "{{22.CLIP_DURATION}}",
                              "o": "notexist"
                            }
                          ]
                        ]
                      },
                      "mapper": {
                        "url": "https://descriptapi.com/v1/jobs/publish",
