          {
            "name": "DESCRIPT_CALLBACK_URL",
            "value": "PASTE_THIS_SCENARIOS_WEBHOOK_URL_HERE"
          },
          {
            "name": "METRICOOL_USER_TOKEN",
            "value": "PASTE_METRICOOL_API_TOKEN_HERE"
          },
          {
            "name": "METRICOOL_USER_ID",
            "value": "5392334"
          },
          {
            "name": "METRICOOL_BLOG_ID",
            "value": "6987872"
          },
          {
            "name": "METRICOOL_AUTO_PUBLISH",
            "value": false
          },
          {
            "name": "CLIPS_FOLDER_ID",
            "value": "1zXQGPU835CXsu8mKd_k8aut8Slf7a3o8"
          },
          {
            "name": "CLIP_COMPOSITION_NAME",
            "value": "AI Dad Clip"
