          {
            "name": "MAX_CLIP_SECONDS",
            "value": 90
          },
          {
            "name": "TIMEZONE",
            "value": "America/New_York"
          },
          {
            "name": "TIKTOK_DAY_OFFSET",
            "value": 1
          },
          {
            "name": "TIKTOK_POST_TIME",
            "value": "10:00:00"
